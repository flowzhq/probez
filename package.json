{
  "name": "probez-cli",
  "version": "0.3.3",
  "description": "See what your coding agents actually did. Every session, measured locally.",
  "keywords": [
    "claude-code",
    "coding-agent",
    "llm",
    "observability",
    "analytics",
    "developer-productivity",
    "cli"
  ],
  "homepage": "https://github.com/flowzhq/probez#readme",
  "bugs": "https://github.com/flowzhq/probez/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flowzhq/probez.git"
  },
  "license": "MIT",
  "author": "flowzhq",
  "type": "module",
  "bin": {
    "probez": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "dist/view",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:cli && npm run build:web",
    "build:cli": "tsc",
    "build:web": "vite build",
    "dev": "vite",
    "test": "npm run build && node --test dist/test/*.test.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm test",
    "logos": "node scripts/logos.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@visx/axis": "^4.0.0",
    "@visx/brush": "^4.0.0",
    "@visx/group": "^4.0.0",
    "@visx/scale": "^4.0.0",
    "@visx/shape": "^4.0.0",
    "@visx/tooltip": "^4.0.0",
    "@vitejs/plugin-react": "^6.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.0",
    "vite": "^8.2.1"
  }
}
